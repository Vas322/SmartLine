# Smartline environment configuration
# Copy to .env and adjust values locally. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (DATABASE_ENGINE=sqlite for local dev, postgresql for server)
DATABASE_ENGINE=postgresql
POSTGRES_DB=smartline
POSTGRES_USER=smartline
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Static / security
STATIC_ROOT=staticfiles
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://smartline-clan.ru

# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_IDS=
# ID канала-источника расписания (где x5_fort_bot публикует расписание; число, например -1001234567890)
SCHEDULE_SOURCE_CHAT_ID=
# username бота альянса, чьи сообщения зеркалируем (без @)
ALLIANCE_BOT_USERNAME=
# ID основной группы клана (опционально; если пусто — берётся из последнего обработанного сообщения)
CLAN_CHAT_ID=
# Prefixes to ignore when mirroring from schedule source channel (comma-separated, case-insensitive)
SCHEDULE_MIRROR_IGNORE_PREFIXES=test,тест,/refresh,/fix
# ID темы (message_thread_id) в целевой группе для зеркала расписания (опционально, для форум-групп)
SCHEDULE_MIRROR_TARGET_THREAD_ID=

# Email (для отправки писем верификации/сброса пароля)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=your-smartline@yandex.ru
EMAIL_HOST_PASSWORD=app-password-here
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=Smartline <your-smartline@yandex.ru>

# Yandex Disk backup
YANDEX_DISK_TOKEN=
YANDEX_DISK_BACKUP_DIR=/Smartline/backups/prod
BACKUP_ENCRYPTION_PASSPHRASE=