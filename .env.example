# Smartline environment configuration
# Copy to .env and adjust values locally. Never commit .env.

DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=smartline
POSTGRES_USER=smartline
POSTGRES_PASSWORD=smartline
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_IDS=

# Local development without PostgreSQL: uncomment the line below.
# DATABASE_ENGINE=sqlite
